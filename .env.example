# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Get the real values from a teammate through a private channel.

# Socrata app token (Cambridge + Somerville open data). Free:
# https://data.cambridgema.gov/profile/edit/developer_settings -> Create New App Token
SOCRATA_APP_TOKEN=

# Optional: MBTA V3 key for 1000 req/min instead of ~20. Free:
# https://api-v3.mbta.com/register
MBTA_API_KEY=
