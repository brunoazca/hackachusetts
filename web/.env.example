# Required: public client configuration for a populated Piper database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ask Piper: server-only Vercel AI Gateway configuration.
# Verified with free credits on 2026-10-24; model eligibility can change.
MODEL_PROVIDER=gateway
MODEL_ID=openai/gpt-4.1-mini
AI_GATEWAY_API_KEY=

# Optional: server-only credentials for the Refresh button.
# Never prefix these or a service-role key with NEXT_PUBLIC_.
MODAL_REFRESH_URL=
RAT_AUDIT_WORKER_TOKEN=
