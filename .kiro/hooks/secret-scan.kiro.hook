{
  "name": "Secret scan on save",
  "description": "This repo is public. When code, docs, data, Kiro config or the synced audit log change, scan for credentials before they can be committed or shown in the demo video.",
  "trigger": {
    "type": "fileEdited",
    "patterns": [
      "web/**/*",
      "pipeline/**/*",
      "supabase/**/*",
      "src/**/*",
      "docs/**/*",
      "knowledge/**/*",
      "data/**/*",
      ".kiro/**/*",
      "*.md",
      "*.json",
      "*.yaml",
      "*.yml",
      "*.env*"
    ]
  },
  "prompt": "A file changed in this PUBLIC repo. From the repo root run exactly `python3 .kiro/scripts/scan_secrets.py` and nothing else first. If it prints `clean`, reply in one line and stop. If it reports findings, do NOT print or repeat any secret value. For each finding, move the value into the git-ignored `.env.local` (template: `.env.example`) and reference it by variable name instead, then rerun until clean. Never edit `.env.local` into git, never disable this hook to get a pass. THEN log it: run `.kiro/klog.sh \"<teammate if known, else —>\" \"secret-scan-hook\" \"secret scan <clean/findings fixed>\" \"public repo, no credentials\" \"<files or —>\" \"—\"` from the repo root.",
  "enabled": true
}
